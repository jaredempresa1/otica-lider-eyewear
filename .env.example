# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave de SERVIÇO do Supabase (Project Settings > API > "service_role").
# NUNCA leva o prefixo NEXT_PUBLIC_ — não pode aparecer no navegador.
# É ela que permite ao site guardar e renovar sozinho o token do Melhor
# Envio. Sem essa variável, a cotação automática de frete volta a exigir
# que você troque o token manualmente na Vercel de tempos em tempos.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Necessária para o site informar se o e-mail já possui conta e evitar
# mensagens genéricas no cadastro e na recuperação de senha.

# Número de WhatsApp que vai receber os pedidos, no formato internacional, só números.
# Exemplo: 55 (Brasil) + 83 (DDD João Pessoa) + número
NEXT_PUBLIC_WHATSAPP_NUMBER=5583900000000

# URL final do site em produção, sem barra no final. Usada na prévia de link
# (WhatsApp/Instagram), no sitemap.xml e no robots.txt. Se essa variável não
# estiver preenchida na Vercel, o código já usa https://www.oticaliderbrasil.com.br
# como padrão — mas é recomendado configurá-la explicitamente também na Vercel.
NEXT_PUBLIC_SITE_URL=https://www.oticaliderbrasil.com.br

# Credenciais do seu aplicativo no Melhor Envio (painel do Melhor Envio >
# Gerenciar aplicações > Criar novo aplicativo). Cadastre a URL de callback
# como https://SEU-DOMINIO/api/melhor-envio/callback.
MELHOR_ENVIO_CLIENT_ID=seu-client-id-do-melhor-envio
MELHOR_ENVIO_CLIENT_SECRET=seu-client-secret-do-melhor-envio
MELHOR_ENVIO_USER_AGENT=Otica Lider Eyewear (seu-email-de-suporte)

# Senha inventada por você (qualquer texto longo e difícil de adivinhar).
# Protege a rota /api/melhor-envio/authorize para que só quem souber essa
# senha consiga (re)conectar a conta do Melhor Envio ao site. Sem ela, a
# rota de autorização fica bloqueada.
MELHOR_ENVIO_SETUP_SECRET=invente-uma-senha-longa-e-aleatoria-aqui

# Só usado como último recurso, se algum dia SUPABASE_SERVICE_ROLE_KEY não
# estiver configurada: um token fixo do Melhor Envio, sem renovação
# automática (expira periodicamente e precisa ser trocado à mão). Com a
# chave de serviço configurada, essa variável pode ficar vazia.
MELHOR_ENVIO_TOKEN=
